# Do not put credentials in source control.
CRAWLER_BACKEND_INGEST_URL="http://127.0.0.1:3000/api/internal/content-ingestion/browser"
# 定时模式只从该内部接口读取高校自动采集总开关。
CRAWLER_BACKEND_CONTROL_URL="http://127.0.0.1:3000/api/internal/content-ingestion/automation"
CRAWLER_BACKEND_TOKEN=""
CRAWLER_HEADLESS="true"
# Optional local override; leave empty on a deployment server.
CRAWLER_BROWSER_EXECUTABLE_PATH=""
CRAWLER_REQUEST_DELAY_SECONDS="1.5"
CRAWLER_UPLOAD_BATCH_SIZE="25"
# 社区试点只把已渲染公开文本直传后端，不在本机保存网页正文。
CRAWLER_COMMUNITY_INGEST_URL="http://127.0.0.1:3000/api/internal/content-ingestion/community"
BRAVE_SEARCH_API_KEY=""
COMMUNITY_DISCOVERY_MAX_RESULTS="140"
COMMUNITY_REQUEST_DELAY_SECONDS="3.0"
# 应替换为真实运维联系地址，用于透明标识爬虫身份。
CRAWLER_CONTACT="crawler-contact-not-configured"
